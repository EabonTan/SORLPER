<launch>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find autolabor_navigation_launch)/worlds/env2.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find autolabor_description)/urdf/integration.xacro" />

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"  args="-urdf -model autolabor_pro -x 0 -y 0 -z 0 -param robot_description" />

  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find autolabor_description)/rviz/urdf.rviz" />   -->

</launch>
